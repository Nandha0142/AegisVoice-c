{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "npm",
      "script": "dev",
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "fileLocation": "relative",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "building for production|VITE v",
          "endsPattern": "ready in|Local:"
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "label": "npm: dev"
    }
  ]
}
